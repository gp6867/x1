@app.post("/chat")
def chat(message: str, user_id: str = "demo_user"):

    # 1️⃣ Intent detect
    intent = detect_intent(message)

    # 2️⃣ Task weight
    weight = task_weight(intent, message)

    # 3️⃣ Usage check
    allowed = check_usage(user_id, weight)
    if not allowed:
        return {"error": "Usage limit reached"}

    # 4️⃣ Model select
    model = select_model(intent, weight)

    # 5️⃣ Call Ollama
    ai_response = ask_ollama(model, message)

